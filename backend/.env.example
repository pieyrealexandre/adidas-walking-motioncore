# Supabase (shared with bball — eu-central-1, Frankfurt, migrated 2026-05-20)
SUPABASE_PROJECT_ID=ylgmmgdkcazhnubxyoho
SUPA_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard>

# Anthropic — used by smart-crop's vision fallback (modes: box, focal, product)
CROPPING_PROTOTYPE_ANTHROPIC_KEY=<anthropic-api-key>
ANTHROPIC_API_KEY=<anthropic-api-key>

# Google Cloud Storage
GCS_BUCKET_NAME=saga-running-japan-images-eu

# Local-dev only: path to GCS service account JSON (place at backend/gcs-service-account.json, gitignored)
# In Cloud Run, ambient credentials are used instead.
GOOGLE_APPLICATION_CREDENTIALS=./gcs-service-account.json

# Server
PORT=8080
LOG_PRETTY=true
RATE_LIMIT_MAX=100
